{
  "name": "agent-canvas",
  "version": "0.0.1",
  "private": true,
  "description": "多 agent 并行开发/实验的可视化监控与操纵画布",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:server": "npm run dev --workspace apps/server"
  },
  "engines": {
    "node": ">=20"
  }
}
